# Mash Potato — environment variables.
# Copy this file to `.env` and fill in the values. `.env` is gitignored;
# this example file is committed.
#
# Local Supabase — get these from `npx supabase start` / `npx supabase status`:
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Only the anon key belongs in the client. The service_role key and the TMDB
# API key must NEVER live here — proxy those through a Supabase Edge Function.
