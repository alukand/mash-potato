# Production build environment (TestFlight / Play builds).
# Copy to `.env.production` (gitignored) and fill in from your HOSTED Supabase
# project (Settings -> API). Local 127.0.0.1 values will NOT work on a device.
#
# `npm run build` uses this automatically when NODE_ENV=production (Vite mode).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
